# ============================================================
# SoraPay — Environment Variables
# ============================================================
# Isi langsung di Vercel Dashboard > Project > Settings > Environment Variables.
# JANGAN commit file .env asli (berisi value sungguhan) ke GitHub —
# file ini (.env.example) cuma template kosong, aman untuk di-commit.
# ============================================================

# --- Firebase Client Config (WAJIB — dipakai fitur VIP: login, database) ---
# Ambil dari: Firebase Console > Project Settings > Your apps > Web app > SDK config
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# --- Firebase Admin SDK (WAJIB — dipakai server untuk bikin akun admin) ---
# Ambil dari: Firebase Console > Project Settings > Service Accounts > Generate new private key
# Setelah download file JSON-nya, buka filenya, copy SELURUH ISINYA (satu baris, tanpa format ulang)
# ke value env var ini.
FIREBASE_SERVICE_ACCOUNT_JSON=

# --- Akun Admin (WAJIB — akun ini yang otomatis jadi admin pertama) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Notifikasi Telegram (OPSIONAL — kalau kosong, notifikasi cuma di-skip, tidak error) ---
# Bikin bot baru lewat @BotFather di Telegram untuk dapat token.
# Chat ID bisa didapat dari bot seperti @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ============================================================
# Catatan soal API downloader (TikTok, Instagram, Pinterest):
# API-API ini SENGAJA TIDAK dimasukkan ke sini karena semuanya
# publik & tanpa API key (tikwm.com, fastdl.app/f-d.app, savepin.app,
# widgets.pinterest.com) — tidak ada rahasia yang perlu disembunyikan,
# jadi endpoint-nya langsung ditulis di dalam index.html.
# ============================================================
