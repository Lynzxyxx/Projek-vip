rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/adminConfig/main) &&
        get(/databases/$(database)/documents/adminConfig/main).data.adminUid == request.auth.uid;
    }

    // Dokumen penanda siapa admin. Dibuat otomatis oleh server (/api/setup-admin),
    // jadi client sama sekali tidak boleh menulis ke sini.
    match /adminConfig/main {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Profil user (role, banned). User cuma boleh baca datanya sendiri;
    // admin boleh baca & ubah semua (untuk ban/unban, dsb).
    // Pembuatan akun baru HANYA lewat admin (client secondary-app trick), makanya create dibatasi admin.
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Fitur VIP. User yang sudah login (dan tidak banned, dicek di client) boleh baca.
    // Cuma admin yang boleh tambah/edit/hapus.
    match /vipFeatures/{featureId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // Fitur tambahan (non-VIP). Boleh dibaca SIAPA SAJA (termasuk yang belum login),
    // karena memang ditujukan untuk publik. Cuma admin yang boleh tambah/hapus.
    match /freeFeatures/{featureId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Folder menu (pengelompokan fitur di sidebar). Publik bisa baca, admin yang atur.
    match /menuFolders/{folderId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Pengaturan umum (nomor WhatsApp, dsb). Publik bisa baca, admin yang atur.
    match /settings/{settingId} {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if false;
    }
  }
}
